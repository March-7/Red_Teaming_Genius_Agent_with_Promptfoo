# Local interface consumed by Promptfoo. This is not a Genius credential.
GENIUS_WEB_API_KEY=sk-local-test
GENIUS_WEB_BASE_URL=http://127.0.0.1:4030/v1
GENIUS_SHIM_HOST=127.0.0.1
GENIUS_SHIM_PORT=4030

# Obtain these values from an authorized Genius browser session. Never commit
# the real Bearer token or paste it into chat, logs, issues, or reports.
GENIUS_AUTHORIZATION="Bearer <authorized-short-lived-jwt>"
GENIUS_UPSTREAM_BASE_URL=https://your-authorized-genius-host.example
GENIUS_CONNECT_HOST=
GENIUS_ORG_ID=
GENIUS_MODEL_PROFILE=default

# Conservative runtime defaults. A retry is allowed only before any semantic
# progress has been observed; see docs/genius_shim.md for the exact boundary.
GENIUS_UPSTREAM_TIMEOUT_S=180
GENIUS_HARD_TIMEOUT_S=180
GENIUS_UPSTREAM_RETRY_ATTEMPTS=1
GENIUS_UPSTREAM_RETRY_WAIT_S=1
GENIUS_SESSION_TTL_S=1800
GENIUS_TOKEN_REFRESH_MARGIN_S=300

# Local, Git-ignored audit artifacts.
GENIUS_TRACE_JSONL=logs/genius_trace.jsonl
GENIUS_LIFECYCLE_JSONL=logs/genius_session_lifecycle.jsonl
GENIUS_TRACE_RAW_EVENTS=false

# Optional, default-deny controlled approvals. Leave empty to block all
# high-risk approvals. The referenced file must contain exact rules and a
# verified protocol; never put Genius credentials in this policy file.
GENIUS_APPROVAL_POLICY_FILE=
GENIUS_SHIM_LOG_LEVEL=INFO
